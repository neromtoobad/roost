# Copy to .env.local.

# ── Binance Web3 API ────────────────────────────────────────────────────────
# Key from https://web3.binance.com/en/dev-portal. Register for the hackathon to get
# elevated rate limits: https://forms.gle/NEmy3FxYc4f5Dua47
# Requests are signed — see https://web3.binance.com/en/dev-docs/authentication
BINANCE_W3_API_KEY=
BINANCE_W3_API_SECRET=
BINANCE_W3_BASE=https://web3.binance.com/build

# ── BSC ─────────────────────────────────────────────────────────────────────
# Chain 56 (BSC mainnet). The hackathon is mainnet-only; dry-run every call through
# the Transaction API simulate endpoint before broadcasting.
NEXT_PUBLIC_CHAIN_ID=56
NEXT_PUBLIC_BSC_RPC=https://bsc-dataseed.bnbchain.org

# ── Persistence ─────────────────────────────────────────────────────────────
# Railway Postgres. In Railway set this to ${{Postgres.DATABASE_URL}} (private network).
# Locally use DATABASE_PUBLIC_URL from the Postgres service → Variables.
# Without it the app still runs — the board is empty and nothing syncs.
DATABASE_URL=

# ── Agent layer ─────────────────────────────────────────────────────────────
# Binance Agentic Wallet / Wallet Skills — the AI execution layer.
# https://developers.binance.com/en/docs/products/agentic-wallet/welcome
AGENTIC_WALLET_KEY=

# BNB Agent Studio — persistent on-chain agent runtime, ERC-8004 identity.
# https://www.bnbchain.org/en/bnb-agent-studio
AGENT_STUDIO_KEY=

# Optional. When set, POST /api/tick with an x-tick-secret header runs one hourly
# tick on demand. The Railway cron service does not need it.
TICK_SECRET=
